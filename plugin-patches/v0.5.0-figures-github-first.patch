+#!/usr/bin/env python3
+"""把 GDD、各系统设计页、界面清单、章节内容表合成一页「设计总览」网页，给用户从总览图看起。
+
+用法：
+  python3 render_design.py <项目根> [--step "第 6 / 19 步 · 系统设计"] [--status 待你确认]
+
+读：
+  design/GDD.md                 第一节「总览」；标题「# GDD · 〈游戏名〉」里取游戏名
+  design/systems-index.json     按顺序取每个系统的 design 页（文件存在的才放进来），节名用 name
+  design/ui/SCREENS.md          「界面清单」
+  design/CONTENT_SCHEDULE.md    「章节内容表」
+  design/figures/<名字>.html    手画的图。.md 里在 mermaid 块前一行写 <!-- figure: 名字 -->，
+                                页面就用这张图替换那块 mermaid（.md 里的 mermaid 原样保留）
+写：
+  design/design_overview.html   发布成页面给用户看；改设计以各 .md 为准，改完重跑
+
+没配手画图的 mermaid 块原样交给页面渲染，并在终端提醒：页面自带的 mermaid 会把长的中文标签截掉。
+需要 Python 的 markdown 包（pip install markdown）。
+"""
+import argparse
+import datetime
+import html
+import json
+import re
+import sys
+from pathlib import Path
+
+try:
+    import markdown
+except ImportError:
+    sys.exit("缺少 markdown 包：pip install markdown")
+
+HERE = Path(__file__).resolve().parent
+MAX_LABELED_EDGES = 5
+MAX_LABEL_CHARS = 12
+
+
+def sections_of(root):
+    tail = [("screens", "界面清单", "design/ui/SCREENS.md"),
+            ("schedule", "章节内容表", "design/CONTENT_SCHEDULE.md")]
+    secs = [("gdd", "总览", "design/GDD.md")]
+    seen = {"design/GDD.md"} | {p for _, _, p in tail}
+    idx = root / "design" / "systems-index.json"
+    if idx.exists():
+        for s in json.loads(idx.read_text(encoding="utf-8")).get("systems", []):
+            page = s.get("design")
+            # 几个系统共用一页（如结局写在看水面那页）、界面系统指向 SCREENS 时，只放一次
+            if page and page not in seen and (root / page).exists():
+                seen.add(page)
+                secs.append((s["id"], s.get("name") or s["id"], page))
+    secs += tail
+    return [s for s in secs if (root / s[2]).exists()]
+
+
+def lint_mermaid(src, where, warnings):
+    labels = re.findall(r"-->\s*\|([^|]*)\||--\s+([^->][^>]*?)\s+-->", src)
+    labels = [a or b for a, b in labels]
+    if len(labels) > MAX_LABELED_EDGES:
+        warnings.append(f"{where}：一张图里有 {len(labels)} 条带字的箭头，超过 {MAX_LABELED_EDGES} 条：按问题拆成几张，界面跳转图改成路线表（figures.md 第 3 节）")
+    for lb in labels:
+        if len(lb.strip()) > MAX_LABEL_CHARS:
+            warnings.append(f"{where}：箭头上的字「{lb.strip()}」超过 {MAX_LABEL_CHARS} 个，解释挪到图下一句话")
+
+
+def render(root, sid, path, links, warnings):
+    text = (root / path).read_text(encoding="utf-8")
+    figs, blocks = [], []
+
+    def keep_fig(m):
+        name, src = m.group(1), m.group(2)
+        frag = root / "design" / "figures" / f"{name}.html"
+        if not frag.exists():
+            warnings.append(f"{path}：标了 figure: {name}，但 design/figures/{name}.html 不存在，先用 mermaid 顶上")
+            lint_mermaid(src, path, warnings)
+            blocks.append(src)
+            return f"\n\nMERMAIDBLOCK{len(blocks) - 1}\n\n"
+        figs.append(frag.read_text(encoding="utf-8"))
+        return f"\n\nFIGUREBLOCK{len(figs) - 1}\n\n"
+
+    def keep(m):
+        blocks.append(m.group(1))
+        lint_mermaid(m.group(1), path, warnings)   # 只查要交给页面自己画的 mermaid
+        warnings.append(f"{path}：有一张 mermaid 图没配手画图（design/figures/），页面上长标签可能被截掉")
+        return f"\n\nMERMAIDBLOCK{len(blocks) - 1}\n\n"
+
+    text = re.sub(r"<!-- figure: ([\w-]+) -->\s*\n```mermaid\n(.*?)```", keep_fig, text, flags=re.S)
+    text = re.sub(r"```mermaid\n(.*?)```", keep, text, flags=re.S)
+    # 标题降一级：整页只有一个 h1
+    text = "\n".join(("#" + ln) if ln.startswith("#") else ln for ln in text.split("\n"))
+    # 文档路径换成页内链接
+    for p, target in links.items():
+        text = text.replace(p, f"[{p.split('/')[-1]}](#{target})")
+    text = re.sub(r"[（(]claude\.ai/artifact/(\w+)[）)]", r"（[打开](https://claude.ai/artifact/\1)）", text)
+    out = markdown.markdown(text, extensions=["tables", "fenced_code"])
+    for i, frag in enumerate(figs):
+        out = out.replace(f"<p>FIGUREBLOCK{i}</p>", f'<div class="diagram">{frag}</div>')
+    for i, src in enumerate(blocks):
+        out = out.replace(f"<p>MERMAIDBLOCK{i}</p>",
+                          f'<div class="diagram"><pre class="mermaid">{html.escape(src.strip())}</pre></div>')
+    out = out.replace("<table>", '<div class="table-wrap"><table>').replace("</table>", "</table></div>")
+    first = True
+
+    def h2(m):
+        nonlocal first
+        if first:
+            first = False
+            return f'<h2 class="sec-title">{m.group(1)}</h2>'
+        return f'<h2 class="split">{m.group(1)}</h2>'   # 设计页里的「给实现看」
+
+    out = re.sub(r"<h2>(.*?)</h2>", h2, out)
+    return f'<section id="{sid}" class="doc doc-{sid}">{out}</section>'
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("root")
+    ap.add_argument("--step", default="系统设计")
+    ap.add_argument("--status", default="待你确认")
+    a = ap.parse_args()
+    root = Path(a.root).resolve()
+    gdd = root / "design" / "GDD.md"
+    if not gdd.exists():
+        sys.exit("没有 design/GDD.md：先按 references/GDD.template.md 写")
+    m = re.match(r"#\s*GDD\s*[·:：]\s*(.+)", gdd.read_text(encoding="utf-8").splitlines()[0])
+    game = m.group(1).strip() if m else root.name
+    game = re.sub(r"[（(][^）)]*[）)]\s*$", "", game).strip()   # 去掉「（暂定名）」
+    secs = sections_of(root)
+    links = {p: sid for sid, _, p in secs}
+    warnings = []
+    nav = "".join(f'<a href="#{sid}" data-sec="{sid}">{html.escape(name)}</a>' for sid, name, _ in secs)
+    body = "\n".join(render(root, sid, p, links, warnings) for sid, _, p in secs)
+    tpl = (HERE / "design_overview.template.html").read_text(encoding="utf-8")
+    page = (tpl.replace("<!--GAME-->", html.escape(game))
+               .replace("<!--STEP-->", html.escape(f"{a.step} · {datetime.date.today().isoformat()}"))
+               .replace("<!--STATUS-->", html.escape(a.status))
+               .replace("<!--NAV-->", nav).replace("<!--BODY-->", body))
+    dst = root / "design" / "design_overview.html"
+    dst.write_text(page, encoding="utf-8")
+    print(f"写好 {dst.relative_to(root)}：{len(secs)} 节")
+    for w in dict.fromkeys(warnings):
+        print("提醒：" + w)
+
+
+if __name__ == "__main__":
+    main()
